---
import { reviews, reviewStats } from '../data/reviews';
import { BUSINESS_ID } from '../data/business';

function initial(name: string): string {
	return name.trim().charAt(0).toUpperCase();
}

// Deterministic accent per reviewer so avatars vary without randomness.
const avatarColors = ['bg-battle-yellow text-black', 'bg-gray-900 text-white', 'bg-yellow-500 text-black'];

// AggregateRating + Review live here (not in Layout) so the markup is only
// emitted on pages where the reviews are actually visible, as Google requires.
// The @id ties this node to the global Electrician node in Layout.astro.
const reviewsSchema = {
	'@context': 'https://schema.org',
	'@type': 'Electrician',
	'@id': BUSINESS_ID,
	name: 'Battle Electric',
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: Number(reviewStats.rating),
		reviewCount: reviewStats.count,
		bestRating: 5,
	},
	review: reviews.map((review) => ({
		'@type': 'Review',
		author: { '@type': 'Person', name: review.author_name },
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />

<section class="max-w-6xl mx-auto p-4 md:p-8" aria-labelledby="reviews-title">
	<h2 id="reviews-title" class="text-2xl md:text-3xl font-bold uppercase tracking-tight text-gray-800 text-center mb-4">
		Customer Reviews
	</h2>

	<!-- Aggregate rating: the site's strongest social proof, sourced from src/data/reviews.ts -->
	<div class="text-center mb-10">
		<p class="flex items-center justify-center gap-2 text-lg font-semibold text-gray-800 mb-3">
			<span class="text-yellow-500 text-xl" aria-hidden="true">★★★★★</span>
			{reviewStats.rating} · {reviewStats.countLabel} Google reviews
		</p>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-sm">
			<a
				href={reviewStats.listingUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="text-gray-600 underline underline-offset-4 hover:text-black transition-colors"
			>
				Read all our reviews on Google →
			</a>
			<a
				href={reviewStats.reviewUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block bg-battle-yellow hover:bg-battle-yellow-hover border border-black text-black font-semibold px-4 py-2 rounded-lg transition-colors"
			>
				Leave us a review
			</a>
		</div>
	</div>

	<!-- Masonry grid: every review visible at a glance (no carousel blindness) -->
	<div class="columns-1 md:columns-2 lg:columns-3 gap-6">
		{
			reviews.map((review, index) => (
				<article class="review-card break-inside-avoid mb-6 bg-white rounded-xl shadow-md border border-gray-100 p-6">
					<header class="flex items-center gap-3 mb-3">
						<span
							class={`w-11 h-11 rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0 ${avatarColors[index % avatarColors.length]}`}
							aria-hidden="true"
						>
							{initial(review.author_name)}
						</span>
						<div class="min-w-0">
							<h3 class="font-semibold text-gray-900 truncate">{review.author_name}</h3>
							<p class="text-xs text-gray-400 flex items-center gap-1">
								<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" aria-hidden="true">
									<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z" />
									<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
									<path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18A10.97 10.97 0 001 12c0 1.77.42 3.45 1.18 4.94l3.66-2.84z" />
									<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
								</svg>
								{review.date ? `${review.date} · ` : ''}Google review
							</p>
						</div>
					</header>

					<p class="text-yellow-500 mb-2" aria-label={`${review.rating} out of 5 stars`}>
						{'★'.repeat(review.rating)}<span class="text-gray-300">{'☆'.repeat(5 - review.rating)}</span>
					</p>

					<div class="review-text-wrapper">
						<p class="review-text text-gray-600 text-sm leading-relaxed whitespace-pre-line">{review.text}</p>
						<button
							class="show-more-btn hidden mt-2 text-sm font-medium text-gray-700 underline underline-offset-4 hover:text-black transition-colors focus:outline-none focus:ring-2 focus:ring-battle-yellow rounded px-1"
							aria-expanded="false"
						>
							Show more
						</button>
					</div>
				</article>
			))
		}
	</div>
</section>

<script>
	function initShowMoreButtons() {
		const wrappers = document.querySelectorAll('.review-text-wrapper');

		wrappers.forEach((wrapper) => {
			const text = wrapper.querySelector('.review-text') as HTMLElement | null;
			const button = wrapper.querySelector('.show-more-btn') as HTMLButtonElement | null;
			if (!text || !button) return;

			text.classList.add('clamped');
			button.textContent = 'Show more';
			button.setAttribute('aria-expanded', 'false');
			const isOverflowing = text.scrollHeight > text.clientHeight + 1;
			button.classList.toggle('hidden', !isOverflowing);
			if (!isOverflowing) return;

			if (button.dataset.bound) return;
			button.dataset.bound = 'true';
			button.addEventListener('click', () => {
				const expanded = text.classList.toggle('clamped') === false;
				button.textContent = expanded ? 'Show less' : 'Show more';
				button.setAttribute('aria-expanded', String(expanded));
			});
		});
	}

	initShowMoreButtons();
	document.addEventListener('astro:page-load', initShowMoreButtons);
</script>

<style>
	.review-text {
		word-break: break-word;
		overflow-wrap: break-word;
	}

	.review-text.clamped {
		display: -webkit-box;
		-webkit-line-clamp: 6;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>

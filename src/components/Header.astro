---
import FreeQuoteButton from './FreeQuoteButton.astro';
---

<!-- Top Bar -->
<div class="bg-gray-500 text-white py-2 px-4">
	<div class="flex items-center justify-between max-w-7xl mx-auto">
		<div class="flex items-center gap-6 text-sm">
			<a href="tel:7864043885" class="flex items-center gap-2 hover:text-yellow-400 transition-colors">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
					></path>
				</svg>
				(786) 404-3885
			</a>
			<span class="hidden md:block">|</span>
			<span class="hidden md:block">Licensed & Insured Electrical Contractor</span>
		</div>
		<span class="md:block text-sm">License NO. EC13010206</span>
		<div class="hidden md:block text-sm">Mon-Sat: 7AM-7PM | Emergency 24/7</div>
	</div>
</div>

<header class="sticky top-0 z-50 p-4 bg-white border-b border-white/12 shadow-lg transition-all duration-300">
	<nav class="flex items-center justify-between max-w-7xl mx-auto">
		<!-- Logo -->
		<a href="/" class="flex-shrink-0">
			<img src="/logo-header.webp" alt="Battle Electric Logo" width="304" height="224" class="h-20 md:h-28 w-auto" />
		</a>

		<!-- Desktop Navigation: services shown directly, no dropdown (BAT-14) -->
		<div class="hidden lg:flex gap-6 items-center">
			<a href="/services/ev-charging" class="nav-link hover:text-gray-600 font-medium transition-colors duration-300">
				EV Charging
			</a>

			<a href="/services/smart-panel" class="nav-link hover:text-gray-600 font-medium transition-colors duration-300">
				Smart Panels
			</a>

			<a href="/services/electrical-panel" class="nav-link hover:text-gray-600 font-medium transition-colors duration-300">
				Electrical Panels
			</a>

			<a href="/about-us" class="nav-link hover:text-gray-600 font-medium transition-colors duration-300">
				About Us
			</a>

			<a href="/contact-us" class="nav-link hover:text-gray-600 font-medium transition-colors duration-300">
				Contact Us
			</a>
		</div>

		<!-- Desktop CTA -->
		<div class="hidden lg:inline-block">
			<FreeQuoteButton />
		</div>

		<!-- Mobile Menu Button -->
		<button
			id="mobile-menu-button"
			class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg transition-colors duration-200"
			aria-label="Toggle mobile menu"
			aria-expanded="false"
		>
			<svg
				id="menu-icon"
				class="w-6 h-6 transition-transform duration-200"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
				></path>
			</svg>
			<svg
				id="close-icon"
				class="w-6 h-6 hidden transition-transform duration-200"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</nav>

	<!-- Mobile Menu -->
	<div id="mobile-menu" class="lg:hidden opacity-0 mt-4 pb-4 overflow-hidden max-h-0">
		<div class="flex flex-col space-y-4">
			<a href="/services/ev-charging" class="block py-2 px-4 rounded-lg transition-colors font-medium">
				EV Charging
			</a>
			<a href="/services/smart-panel" class="block py-2 px-4 rounded-lg transition-colors font-medium">
				Smart Panels
			</a>
			<a href="/services/electrical-panel" class="block py-2 px-4 rounded-lg transition-colors font-medium">
				Electrical Panels
			</a>

			<a href="/about-us" class="block py-2 px-4
				 rounded-lg transition-colors font-medium"> About Us </a>

			<a href="/contact-us" class="block py-2 px-4
				 rounded-lg transition-colors font-medium"> Contact Us </a>

			<!-- Mobile CTA -->
			<a href="/contact-us" class="block mx-4 mt-4 px-4 py-3 bg-battle-yellow text-center rounded-lg font-medium">
				Get Free Quote
			</a>
		</div>
	</div>
</header>

<style>
	.nav-link {
		position: relative;

		text-decoration: none;
		display: inline-flex;
	}

	.nav-link::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0;
		height: 2px;
		background: #e6d428;
		transform: translateX(-50%);
		transition: width 0.3s ease;
	}

	.nav-link:hover::before {
		width: 80%;
	}

	/* Mobile menu animations */
	#mobile-menu {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.4s ease-out,
			opacity 0.3s ease-out;
		pointer-events: none;
	}

	#mobile-menu.show {
		max-height: 500px;
		opacity: 1;
		pointer-events: auto;
	}
</style>

<script>
	function initializeHeader() {
		// Mobile menu functionality
		const mobileMenuButton = document.getElementById('mobile-menu-button');
		const mobileMenu = document.getElementById('mobile-menu');
		const menuIcon = document.getElementById('menu-icon');
		const closeIcon = document.getElementById('close-icon');

		// Exit early if any required element is missing
		if (!mobileMenuButton || !mobileMenu || !menuIcon || !closeIcon) {
			return;
		}

		let isOpen = false;

		function toggleMobileMenu() {
			// Additional null checks for TypeScript
			if (!mobileMenu || !menuIcon || !closeIcon || !mobileMenuButton) return;

			isOpen = !isOpen;

			if (isOpen) {
				// ABRIR: Inmediatamente añadir clase show para activar animación
				mobileMenu.classList.add('show');
				menuIcon.classList.add('hidden');
				closeIcon.classList.remove('hidden');
				mobileMenuButton.setAttribute('aria-expanded', 'true');
			} else {
				// CERRAR: Remover clase show para activar animación de cierre
				mobileMenu.classList.remove('show');
				menuIcon.classList.remove('hidden');
				closeIcon.classList.add('hidden');
				mobileMenuButton.setAttribute('aria-expanded', 'false');
			}
		}

		// Mobile menu button click
		mobileMenuButton.addEventListener('click', toggleMobileMenu);

		// Close mobile menu when clicking on links
		const mobileLinks = mobileMenu.querySelectorAll('a');
		mobileLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (isOpen) toggleMobileMenu();
			});
		});

		// Close mobile menu on window resize to desktop (lg breakpoint)
		window.addEventListener('resize', () => {
			if (window.innerWidth >= 1024 && isOpen) {
				toggleMobileMenu();
			}
		});
	}

	// Initialize
	document.addEventListener('DOMContentLoaded', initializeHeader);
	document.addEventListener('astro:page-load', initializeHeader);
</script>

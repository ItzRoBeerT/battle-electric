---
import Layout from "../layouts/Layout.astro"
const title = "Privacy Policy | Battle Electric"
const description = "How Battle Electric collects, uses, and protects your personal information."
---

<Layout title={title} description={description}>
	<section class="bg-gray-900 text-white py-16 px-4">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl font-bold uppercase tracking-tight mb-3">Privacy Policy</h1>
			<p class="text-gray-300">Effective date: September 2026</p>
		</div>
	</section>

	<section class="py-16 px-4">
		<article class="legal-content max-w-3xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 p-8 md:p-12">
			<p>
				Battle Electric, LLC ("Battle Electric", "we", "us") respects your
				privacy. This policy explains what information we collect through
				<strong>battleelectricfl.com</strong> (the "Site"), how we use it, and
				the choices you have.
			</p>

			<h2>Information we collect</h2>
			<h3>Information you provide</h3>
			<p>
				When you submit our contact form (powered by Housecall Pro), we collect
				the information you enter, such as your name, phone number, email
				address, service address, and details about the service you request.
				This information is processed by Housecall Pro on our behalf and is
				used to respond to your request, provide estimates, and schedule
				service.
			</p>
			<h3>Information collected automatically</h3>
			<p>
				We and our service providers use cookies and similar technologies to
				understand how the Site is used and to measure advertising. These
				include:
			</p>
			<ul>
				<li><strong>Google Analytics and Google Ads</strong> (via Google Tag Manager) — site usage and advertising measurement</li>
				<li><strong>Meta Pixel</strong> — advertising measurement on Meta platforms</li>
				<li><strong>Ad360</strong> — advertising measurement</li>
				<li><strong>Vercel Analytics</strong> — anonymous performance and usage metrics</li>
			</ul>
			<p>
				These tools may collect your IP address, device and browser
				information, and pages visited.
			</p>

			<h2>How we use information</h2>
			<ul>
				<li>To respond to your inquiries and provide requested services</li>
				<li>To send estimates, scheduling and service communications</li>
				<li>To operate, improve, and secure the Site</li>
				<li>To measure the effectiveness of our advertising</li>
			</ul>

			<h2>Sharing</h2>
			<p>
				We do not sell your personal information. We share it only with
				service providers that help us operate our business (such as Housecall
				Pro for scheduling and lead management, and the analytics/advertising
				providers listed above), or when required by law.
			</p>

			<h2>Your choices</h2>
			<p>
				You can control cookies through your browser settings and opt out of
				personalized advertising through
				<a href="https://adssettings.google.com" rel="noopener noreferrer" target="_blank">Google Ads Settings</a>
				and
				<a href="https://www.facebook.com/adpreferences" rel="noopener noreferrer" target="_blank">Meta Ad Preferences</a>.
				To request access to or deletion of your personal information, contact
				us at the email below.
			</p>

			<h2>Data retention &amp; security</h2>
			<p>
				We keep personal information only as long as needed for the purposes
				described above and take reasonable measures to protect it. No method
				of transmission or storage is 100% secure.
			</p>

			<h2>Children</h2>
			<p>
				The Site is not directed to children under 13 and we do not knowingly
				collect their information.
			</p>

			<h2>Changes</h2>
			<p>
				We may update this policy from time to time. The effective date above
				reflects the latest revision.
			</p>

			<h2>Contact</h2>
			<p>
				Battle Electric, LLC<br />
				13254 SW 263rd St, Homestead, FL 33032<br />
				<a href="mailto:battleelectric050@gmail.com">battleelectric050@gmail.com</a> ·
				<a href="tel:+17864043885">(786) 404-3885</a>
			</p>
		</article>
	</section>
</Layout>

<style is:global>
	.legal-content h2 {
		font-size: 1.25rem;
		font-weight: 700;
		text-transform: uppercase;
		margin: 2rem 0 0.75rem;
	}
	.legal-content h3 {
		font-size: 1.05rem;
		font-weight: 600;
		margin: 1.25rem 0 0.5rem;
	}
	.legal-content p,
	.legal-content li {
		color: #4b5563;
		line-height: 1.7;
		margin-bottom: 0.75rem;
	}
	.legal-content ul {
		list-style: disc;
		padding-left: 1.5rem;
		margin-bottom: 0.75rem;
	}
	.legal-content a {
		text-decoration: underline;
	}
	.legal-content a:hover {
		color: #000;
	}
</style>

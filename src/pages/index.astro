---
import Layout from '../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import Services from '../sections/Services.astro';
import Tesla from '../sections/Tesla.astro';
import ContactUs from '../sections/ContactUs.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Faq from '../components/Faq.astro';
import { GENERAL_FAQS } from '../data/faqs';

const title = 'Licensed Electrician in Miami, FL | Battle Electric';
const description =
	'Licensed & insured electricians serving Miami-Dade, Broward and Monroe. EV charger installation, panel upgrades, smart panels. Free estimates — (786) 404-3885.';

---

<Layout title={title} description={description}>
	<Hero />
	<Services />
	<Tesla />
	<ContactUs />
	<GoogleReviews />
	<Faq items={GENERAL_FAQS} />
</Layout>

---
import Layout from "../layouts/Layout.astro"
const title = "Terms of Service | Battle Electric"
const description = "Terms governing the use of the Battle Electric website and services."
---

<Layout title={title} description={description}>
	<section class="bg-gray-900 text-white py-16 px-4">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl font-bold uppercase tracking-tight mb-3">Terms of Service</h1>
			<p class="text-gray-300">Effective date: September 2026</p>
		</div>
	</section>

	<section class="py-16 px-4">
		<article class="legal-content max-w-3xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 p-8 md:p-12">
			<p>
				These terms govern your use of <strong>battleelectricfl.com</strong>
				(the "Site"), operated by Battle Electric, LLC ("Battle Electric",
				"we", "us"). By using the Site you agree to these terms.
			</p>

			<h2>Informational content</h2>
			<p>
				Content on the Site is provided for general information about our
				services. It is not professional advice for your specific situation
				and may change without notice.
			</p>

			<h2>Estimates and services</h2>
			<p>
				Requesting a quote through the Site does not create a contract. All
				estimates are preliminary and non-binding until confirmed in a written
				agreement signed by both parties. Electrical work is performed under
				the terms of that written agreement.
			</p>

			<h2>Acceptable use</h2>
			<p>
				You agree not to misuse the Site, including attempting to disrupt its
				operation, submitting false or misleading information through our
				forms, or infringing the rights of others.
			</p>

			<h2>Intellectual property</h2>
			<p>
				The Site and its content (text, graphics, logos) are the property of
				Battle Electric, LLC or its licensors and may not be reproduced
				without permission.
			</p>

			<h2>Third-party links and services</h2>
			<p>
				The Site may link to or embed third-party services (such as our
				scheduling provider). We are not responsible for the content or
				practices of third parties.
			</p>

			<h2>Disclaimer and limitation of liability</h2>
			<p>
				The Site is provided "as is" without warranties of any kind. To the
				fullest extent permitted by law, Battle Electric, LLC will not be
				liable for indirect, incidental, or consequential damages arising from
				your use of the Site.
			</p>

			<h2>Governing law</h2>
			<p>
				These terms are governed by the laws of the State of Florida, without
				regard to conflict-of-law principles. Any disputes will be resolved in
				the courts of Miami-Dade County, Florida.
			</p>

			<h2>Changes</h2>
			<p>
				We may update these terms from time to time. Continued use of the Site
				after changes means you accept the updated terms.
			</p>

			<h2>Contact</h2>
			<p>
				Battle Electric, LLC<br />
				13254 SW 263rd St, Homestead, FL 33032<br />
				<a href="mailto:battleelectric050@gmail.com">battleelectric050@gmail.com</a> ·
				<a href="tel:+17864043885">(786) 404-3885</a>
			</p>
		</article>
	</section>
</Layout>

<style is:global>
	.legal-content h2 {
		font-size: 1.25rem;
		font-weight: 700;
		text-transform: uppercase;
		margin: 2rem 0 0.75rem;
	}
	.legal-content p,
	.legal-content li {
		color: #4b5563;
		line-height: 1.7;
		margin-bottom: 0.75rem;
	}
	.legal-content ul {
		list-style: disc;
		padding-left: 1.5rem;
		margin-bottom: 0.75rem;
	}
	.legal-content a {
		text-decoration: underline;
	}
	.legal-content a:hover {
		color: #000;
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Anchor from '../components/Anchor.astro';
import AnchorOutlined from '../components/AnchorOutlined.astro';

const title = 'Page Not Found | Battle Electric';
const description = 'The page you are looking for does not exist. Find our electrical services, service areas, or get in touch with Battle Electric.';
---

<Layout title={title} description={description} robots="noindex, nofollow">
	<section class="min-h-[70vh] flex items-center justify-center px-4 py-20">
		<div class="max-w-xl w-full text-center">
			<p class="big-404 text-8xl md:text-9xl font-bold text-battle-yellow" aria-hidden="true">404</p>
			<h1 class="text-3xl md:text-4xl font-bold mt-4 mb-4">Page not found</h1>
			<p class="text-lg text-gray-700 mb-10">
				The page you're looking for doesn't exist or has moved. Here's how to get back on track:
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
				<Anchor href="/services" text="Our Services" ariaLabel="Explore our electrical services" />
				<AnchorOutlined href="/contact-us" text="Contact Us" ariaLabel="Contact Battle Electric" />
			</div>

			<p class="text-gray-700">
				Need an electrician now? Call us at
				<a href="tel:+17864043885" class="font-semibold underline hover:text-gray-900 whitespace-nowrap">(786) 404-3885</a>
				or see the <a href="/service-areas" class="font-semibold underline hover:text-gray-900">areas we serve</a>.
			</p>
		</div>
	</section>
</Layout>

<style>
	.big-404 {
		-webkit-text-stroke: 2px #1f2937;
		paint-order: stroke fill;
	}
</style>

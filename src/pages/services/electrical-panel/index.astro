---
import Layout from '../../../layouts/Layout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { BUSINESS_ID } from '../../../data/business';
import Hero from '../../../sections/electrical-panel/Hero.astro';
import WhyReplace from '../../../sections/electrical-panel/WhyReplace.astro';
import Services from '../../../sections/electrical-panel/Services.astro';
import WhyChoose from '../../../sections/electrical-panel/WhyChoose.astro';
import CTA from '../../../sections/electrical-panel/CTA.astro';

const title = 'Electrical Panel Installation & Replacement | Battle Electric FL';
const description =
	'Expert electrical panel installation and replacement services in Florida. Free safety inspections, insurance-required upgrades, and modern panel solutions for homes and businesses.';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Electrical Panel Installation',
	serviceType: 'Electrical panel installation and replacement',
	// Reference (not duplicate) the business entity defined in Layout.astro.
	provider: { '@id': BUSINESS_ID },
	description: description,
	areaServed: { '@type': 'State', name: 'Florida' },
};
---

<Layout title={title} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<Breadcrumbs crumbs={[{ name: 'Services', href: '/services' }, { name: 'Electrical Panels' }]} />
	<Hero />
	<div class="relative">
		<div class="img-background absolute inset-0"></div>
		<div class="absolute inset-0 bg-black/30"></div>

		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
			<WhyReplace />
			<Services />
			<WhyChoose />
			<CTA />
		</div>
	</div>
	<Faq
		items={[
			{
				question: 'How do I know if my electrical panel needs an upgrade?',
				answer:
					'An electrical panel upgrade may be recommended when your existing electrical system no longer has the capacity, condition, or safety features needed for your home or planned electrical loads.\n\nSome signs that your panel may need attention include:\n• Frequent breaker trips or breakers that will not reset properly\n• Flickering or dimming lights, especially when major appliances turn on\n• Buzzing, crackling, or unusual sounds coming from the panel\n• Burning odors, discoloration, corrosion, or signs of overheating around the panel or breakers\n• Warm or excessively hot breakers or panel surfaces\n• An older, damaged, or outdated electrical panel\n• Rust, moisture intrusion, or physical deterioration inside or around the panel\n• A 100-amp service that may not have sufficient capacity for today’s electrical demands\n• Adding high-demand equipment such as an EV charger, air-conditioning system, pool equipment, electric range, or other major loads\n• A home that has had multiple electrical additions or modifications over the years without a comprehensive evaluation\n\nThe condition of the panel and the home’s overall electrical load are just as important as the panel’s amp rating. A 100-amp panel may be adequate for one home but insufficient for another, depending on the home’s electrical demand and planned upgrades.\n\nAt Battle Electric, we can evaluate your existing panel, service capacity, wiring, breakers, and planned electrical loads to determine whether an upgrade is actually necessary. If an upgrade is recommended, we’ll explain why and provide a clear, customized estimate before any work begins.\n\nYour electrical panel doesn’t necessarily need to be upgraded just because it’s older — we’ll evaluate the system and recommend the appropriate solution for your home.',
			},
			{
				question: 'How much does an electrical panel upgrade cost?',
				answer:
					'Every panel upgrade is different, so we provide a customized written estimate instead of a one-size-fits-all price. The cost depends on factors like the existing service and panel condition, the amperage you need, meter and grounding work, whether FPL coordination is required, and your municipality’s permit fees.\n\nWe only recommend the work your home actually needs — no unnecessary equipment or upsells — and you get a clear, written estimate before any work begins. The evaluation and estimate are free.',
			},
			{
				question: 'Do panel upgrades require a permit and inspection?',
				answer:
					'Yes. Panel replacements and service upgrades require an electrical permit, inspection, and often coordination with FPL. Battle Electric is a licensed Florida electrical contractor (License NO. EC13010206) and manages the full process.',
			},
			{
				question: 'How long does a panel replacement take?',
				answer:
					'The electrical work is usually completed in one day. Permit approval and utility coordination can add time depending on your municipality, and we schedule everything to minimize the hours without power.',
			},
		]}
	/>
</Layout>

<style>
	.img-background {
		background-image: url('/background-1920.webp');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.img-background::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, #1f2937 0%, #374151 50%, #1f2937 100%);
		z-index: -1;
	}
</style>

---
import Layout from '../../../layouts/Layout.astro';
import Faq from '../../../components/Faq.astro';
import Brands from '../../../sections/ev-charging/Brands.astro';
import Hero from '../../../sections/ev-charging/Hero.astro';
import Installations from '../../../sections/ev-charging/Installations.astro';
import Services from '../../../sections/ev-charging/Services.astro';

const title = 'EV Charging Services | Battle Electric';
const description =
	'Explore our EV charging solutions, including Tesla and other brands. Reliable installations and maintenance for your electric vehicle charging needs.';
---

<Layout title={title} description={description}>
	<Hero />
	<Services />
	<Installations />
	<Brands />
	<Faq
		items={[
			{
				question: 'How much does it cost to install a Level 2 EV charger in Miami-Dade?',
				answer:
					'Most residential Level 2 charger installations in South Florida range from about $800 to $2,500 installed, depending on the distance from your electrical panel, the wiring run, and whether your panel has capacity for the new circuit. We provide a free estimate for every installation.',
			},
			{
				question: 'Do I need a permit to install an EV charger in Florida?',
				answer:
					'Yes. EV charger installations require an electrical permit and inspection. As a licensed Florida electrical contractor (License NO. EC13010206), Battle Electric handles the permit process and inspection for you.',
			},
			{
				question: 'Can you install a Tesla Wall Connector?',
				answer:
					'Yes. We install Tesla Wall Connectors as well as universal Level 2 chargers compatible with any EV brand, for both homes and businesses.',
			},
			{
				question: 'How long does an EV charger installation take?',
				answer:
					'Most residential installations are completed in a single day. Permit approval times vary by municipality in Miami-Dade, Broward, and Monroe County, and we manage that process for you.',
			},
			{
				question: 'Will my electrical panel support a Level 2 charger?',
				answer:
					'It depends on your panel capacity and existing loads. We perform a load calculation before installing. If your panel is at capacity, options include a panel upgrade or a smart panel with load management, both of which we install.',
			},
		]}
	/>
</Layout>

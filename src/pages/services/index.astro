---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import FreeQuoteButton from '../../components/FreeQuoteButton.astro';

import evChargingImage from '../../assets/services/ev-charging/level-2-tesla.jpeg';
import smartPanelImage from '../../../public/span/span-smart-panel.avif';
import electricalPanelImage from '../../assets/services/electrical-panel.jpeg';

const title = 'Electrical Services | Battle Electric FL';
const description =
	'Comprehensive electrical services in Miami-Dade, Broward, and Monroe County. From panel installations to EV charging stations, trust our licensed electricians for all your needs.';

const services = [
	{
		title: 'Electrical Panel Installation',
		description:
			'Expert electrical panel installation and replacement. Safety inspections, insurance-required upgrades, and modern panel solutions for homes and businesses.',
		image: electricalPanelImage,
		features: [
			'Panel upgrades & replacements',
			'Safety inspections',
			'Insurance compliance',
			'Commercial & residential',
		],
		url: '/services/electrical-panel',
	},
	{
		title: 'EV Charger Installation',
		description:
			'Professional electric vehicle charging station installation for homes and businesses. Level 2 charging solutions for all EV brands.',
		image: evChargingImage,
		features: [
			'Level 2 charging stations',
			'Tesla & universal chargers',
			'Smart scheduling',
			'Weather-resistant installation',
		],
		url: '/services/ev-charging',
	},
	{
		title: 'Smart Electrical Panels',
		description:
			'Advanced smart panel technology with remote monitoring, energy management, and smart home integration for modern living.',
		image: smartPanelImage,
		features: [
			'Remote control & monitoring',
			'Energy usage tracking',
			'Smart home integration',
			'Real-time notifications',
		],
		url: '/services/smart-panel',
	},
];

const generalServices = [
	'Complete home rewiring',
	'Troubleshooting & repairs',
	'Lighting installation',
	'Smoke detectors',
	'Outlets & switches',
	'Temporary power for construction',
];

const serviceAreas = ['Miami-Dade County', 'Broward County', 'Monroe County', 'Homestead', 'Miami', 'Fort Lauderdale'];
---

<Layout title={title} description={description}>
	<!-- Hero -->
	<section
		class="hero-section min-h-[55vh] bg-gray-900 relative flex items-center justify-center"
		role="banner"
		aria-labelledby="services-hero-title"
	>
		<div class="hero-background absolute inset-0"></div>
		<div class="absolute inset-0 bg-black/40"></div>

		<div class="relative z-10 text-center px-4 max-w-5xl mx-auto py-20">
			<h1 id="services-hero-title" class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase mb-6">
				Professional Electrical Services
			</h1>
			<p class="text-lg md:text-xl text-gray-200 mb-8 max-w-3xl mx-auto">
				Trusted electrical solutions for homes and businesses across
				<strong>Miami-Dade, Broward, and Monroe County, Florida</strong>
			</p>
			<FreeQuoteButton />
		</div>
	</section>

	<!-- Trust strip -->
	<section class="bg-white border-b border-gray-100 shadow-sm" aria-label="Credentials">
		<div class="max-w-6xl mx-auto px-4 py-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-sm font-semibold text-gray-700">
			<span class="flex items-center gap-2">
				<span class="text-yellow-500" aria-hidden="true">★★★★★</span>
				100+ Google reviews
			</span>
			<a href="/license" class="flex items-center gap-2 hover:text-black underline decoration-battle-yellow decoration-2 underline-offset-4">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
				</svg>
				Licensed &amp; Insured — EC13010206
			</a>
			<span class="flex items-center gap-2">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
				</svg>
				35+ Years Experience
			</span>
		</div>
	</section>

	<!-- Services Grid -->
	<section class="py-16 md:py-20" aria-labelledby="services-title">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 id="services-title" class="text-3xl md:text-4xl font-bold uppercase tracking-tight mb-4">Our Services</h2>
				<p class="text-lg text-gray-600 max-w-2xl mx-auto">
					Comprehensive electrical solutions tailored to your specific needs
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{
					services.map((service, index) => (
						<article class="group bg-white rounded-xl shadow-md hover:shadow-xl border border-gray-100 overflow-hidden transition-all duration-300 hover:-translate-y-1 flex flex-col">
							<div class="relative h-48 overflow-hidden">
								<Image
									src={service.image}
									alt={`${service.title} - Battle Electric professional service`}
									width={400}
									height={300}
									loading={index === 0 ? 'eager' : 'lazy'}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
							</div>

							<div class="p-6 flex flex-col flex-1">
								<h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>

								<p class="text-gray-600 leading-relaxed mb-4">{service.description}</p>

								<ul class="space-y-2 mb-6" role="list">
									{service.features.map((feature) => (
										<li class="flex items-start gap-2 text-sm text-gray-600">
											<svg
												class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
												aria-hidden="true"
											>
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
											</svg>
											<span>{feature}</span>
										</li>
									))}
								</ul>

								<a
									href={service.url}
									class="mt-auto block w-full text-center px-6 py-3 bg-battle-yellow hover:bg-battle-yellow-hover border border-black text-black font-semibold rounded-lg transition-all duration-300 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-battle-yellow/50"
									aria-label={`Learn more about ${service.title}`}
								>
									Learn More
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- General electrical -->
	<section class="py-16 md:py-20 bg-gray-900 text-white" aria-labelledby="general-title">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
				<div>
					<h2 id="general-title" class="text-3xl md:text-4xl font-bold uppercase tracking-tight mb-4">
						Any Electrical Work, Big or Small
					</h2>
					<p class="text-gray-300 text-lg mb-6">
						Beyond our specialties, our licensed electricians handle every kind of
						electrical project — from a single outlet to a complete rewire.
					</p>
					<a
						href="/contact-us"
						class="inline-block bg-battle-yellow border border-black hover:bg-battle-yellow-hover text-black px-8 py-4 rounded-lg font-semibold transition-all duration-300 shadow-lg"
					>
						Tell Us About Your Project
					</a>
				</div>
				<ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
					{
						generalServices.map((item) => (
							<li class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-sm">
								<svg
									class="w-5 h-5 text-battle-yellow flex-shrink-0"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-16 md:py-20" aria-labelledby="why-choose-title">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 id="why-choose-title" class="text-3xl md:text-4xl font-bold uppercase tracking-tight mb-4">
					Why Choose Battle Electric?
				</h2>
				<p class="text-lg text-gray-600 max-w-2xl mx-auto">
					Your trusted partner for all electrical needs in South Florida
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<div class="w-12 h-12 mx-auto mb-4 rounded-full bg-battle-yellow border border-black flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</div>
					<h3 class="text-lg font-bold text-gray-900 mb-2">35+ Years Experience</h3>
					<p class="text-sm text-gray-600">Decades of expertise in residential and commercial electrical work</p>
				</div>
				<div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<div class="w-12 h-12 mx-auto mb-4 rounded-full bg-battle-yellow border border-black flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</div>
					<h3 class="text-lg font-bold text-gray-900 mb-2">Licensed &amp; Insured</h3>
					<p class="text-sm text-gray-600">Florida certified electrical contractor, fully insured for your protection</p>
				</div>
				<div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<div class="w-12 h-12 mx-auto mb-4 rounded-full bg-battle-yellow border border-black flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="text-lg font-bold text-gray-900 mb-2">24/7 Emergency Service</h3>
					<p class="text-sm text-gray-600">Available around the clock for urgent electrical needs</p>
				</div>
				<div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<div class="w-12 h-12 mx-auto mb-4 rounded-full bg-battle-yellow border border-black flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
						</svg>
					</div>
					<h3 class="text-lg font-bold text-gray-900 mb-2">Upfront Pricing</h3>
					<p class="text-sm text-gray-600">Transparent quotes with no hidden fees or surprises</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Service Areas -->
	<section class="pb-16 md:pb-20" aria-labelledby="service-areas-title">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-white rounded-2xl p-8 md:p-12 shadow-md border border-gray-100">
				<h2 id="service-areas-title" class="text-2xl md:text-3xl font-bold uppercase tracking-tight mb-6 text-center">
					Service Areas
				</h2>
				<p class="text-gray-600 text-center mb-8">
					Proudly serving residential and commercial clients throughout South Florida
				</p>
				<div class="flex flex-wrap justify-center gap-3">
					{
						serviceAreas.map((area) => (
							<span class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">{area}</span>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="pb-16 md:pb-20" aria-labelledby="cta-title">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-gradient-to-br from-battle-yellow to-yellow-400 rounded-2xl p-8 md:p-12 shadow-xl text-center">
				<h2 id="cta-title" class="text-3xl md:text-4xl font-bold text-gray-900 uppercase tracking-tight mb-4">
					Ready to Get Started?
				</h2>
				<p class="text-lg text-gray-800 mb-8 max-w-2xl mx-auto">
					Contact us today for a free consultation and quote. Our expert electricians are ready to help with your
					project.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact-us"
						class="inline-block px-8 py-4 bg-gray-900 text-white font-bold rounded-lg hover:bg-gray-800 transition-all duration-300 shadow-lg hover:shadow-xl"
					>
						Get Free Quote
					</a>
					<a
						href="tel:+17864043885"
						class="inline-block px-8 py-4 bg-white text-gray-900 font-bold rounded-lg hover:bg-gray-100 transition-all duration-300 shadow-lg hover:shadow-xl"
					>
						Call (786) 404-3885
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		position: relative;
		overflow: hidden;
	}

	.hero-background {
		background-image: url('/background-1920.webp');
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		background-repeat: no-repeat;
	}

	@media (max-width: 768px) {
		.hero-background {
			background-image: url('/background-960.webp');
			background-attachment: scroll;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

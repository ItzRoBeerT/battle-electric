---
import Layout from "../../layouts/Layout.astro"
const title = "Thank You | Battle Electric"
const description = "Your request has been received. Our team will get back to you shortly."
---

<Layout title={title} description={description} robots="noindex, nofollow">
	<section class="min-h-[70vh] flex items-center justify-center px-4 py-20">
		<div class="thank-you-card max-w-xl w-full bg-white rounded-2xl shadow-xl border border-gray-100 p-10 md:p-14 text-center">
			<!-- Check icon -->
			<div class="check-badge w-20 h-20 mx-auto mb-8 rounded-full bg-battle-yellow border border-black flex items-center justify-center shadow-lg">
				<svg class="w-10 h-10 text-black" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
				</svg>
			</div>

			<h1 class="text-3xl md:text-4xl font-bold uppercase tracking-tight mb-4">
				Request received!
			</h1>
			<p class="text-gray-600 text-lg mb-10 max-w-md mx-auto">
				Thank you for contacting Battle Electric. Our team is reviewing your
				request and will get back to you shortly.
			</p>

			<!-- What happens next -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10 text-left">
				<div class="rounded-lg bg-gray-50 border border-gray-100 p-4">
					<span class="block text-2xl font-bold text-gray-300 mb-1">1</span>
					<p class="text-sm text-gray-600">We review your request</p>
				</div>
				<div class="rounded-lg bg-gray-50 border border-gray-100 p-4">
					<span class="block text-2xl font-bold text-gray-300 mb-1">2</span>
					<p class="text-sm text-gray-600">An expert reaches out to you</p>
				</div>
				<div class="rounded-lg bg-gray-50 border border-gray-100 p-4">
					<span class="block text-2xl font-bold text-gray-300 mb-1">3</span>
					<p class="text-sm text-gray-600">We schedule your service</p>
				</div>
			</div>

			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/"
					class="inline-block bg-battle-yellow border border-black hover:bg-battle-yellow-hover px-8 py-4 rounded-lg font-semibold transition-all duration-300 shadow-lg"
				>
					Back to Home
				</a>
				<a
					href="tel:+17864043885"
					class="inline-flex items-center justify-center gap-2 border border-gray-300 hover:border-black hover:bg-gray-50 px-8 py-4 rounded-lg font-semibold transition-all duration-300"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
					</svg>
					(786) 404-3885
				</a>
			</div>

			<p class="text-gray-400 text-sm mt-10">
				Need urgent help? Call us — we serve all of South Florida.
			</p>
		</div>
	</section>

	<!-- Lead conversion: this page is only reached after a successful form
	     submission, so it is the single source of truth for generate_lead.
	     sessionStorage guard prevents double-counting on reload/revisit. -->
	<script is:inline>
		if (!sessionStorage.getItem('be_lead_fired')) {
			sessionStorage.setItem('be_lead_fired', '1');
			window.dataLayer && window.dataLayer.push({
				event: 'generate_lead',
				page_location: location.href,
			});
			window.fbq && window.fbq('track', 'Lead');
		}
	</script>
</Layout>

<style>
	.thank-you-card {
		animation: card-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.check-badge {
		animation: badge-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes badge-in {
		from {
			opacity: 0;
			transform: scale(0.5);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>

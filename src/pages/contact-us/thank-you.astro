---
import Layout from "../../layouts/Layout.astro"
const title = "Thank You | Battle Electric"
const description = "Your request has been received. Our team will get back to you shortly."
---

<Layout title={title} description={description} robots="noindex, nofollow">
	<section class="max-w-2xl mx-auto px-8 py-24 text-center">
		<h1 class="text-4xl font-bold mb-4">Thank you!</h1>
		<p class="text-gray-600 text-lg mb-2">
			We've received your request and our team will contact you shortly.
		</p>
		<p class="text-gray-600 mb-10">
			Need immediate assistance? Call us at
			<a href="tel:+17864043885" class="font-semibold underline hover:text-yellow-500">(786) 404-3885</a>.
		</p>
		<a
			href="/"
			class="inline-block bg-battle-yellow border border-black hover:bg-gray-500 hover:text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 shadow-lg"
		>
			Back to Home
		</a>
	</section>

	<!-- Lead conversion: this page is only reached after a successful form
	     submission, so it is the single source of truth for generate_lead.
	     sessionStorage guard prevents double-counting on reload/revisit. -->
	<script is:inline>
		if (!sessionStorage.getItem('be_lead_fired')) {
			sessionStorage.setItem('be_lead_fired', '1');
			window.dataLayer && window.dataLayer.push({
				event: 'generate_lead',
				page_location: location.href,
			});
			window.fbq && window.fbq('track', 'Lead');
		}
	</script>
</Layout>

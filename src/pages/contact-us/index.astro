---
import Layout from "../../layouts/Layout.astro"
import ContactForm from "../../components/ContactForm.astro"
import Faq from "../../components/Faq.astro"
import Breadcrumbs from "../../components/Breadcrumbs.astro"
import { LICENSE_LABEL } from "../../data/business"
import { CONTACT_FAQS } from "../../data/faqs"
const title = "Contact Us | Battle Electric"
const description = "Contact Battle Electric in Homestead, FL. Call (786) 404-3885 or request a free quote online. Licensed electricians serving South Florida."

---

<Layout title={title} description={description}>
  <Breadcrumbs crumbs={[{ name: 'Contact Us' }]} />
  <ContactForm />

  <!-- NAP in real HTML: the lead form above is a third-party iframe, invisible
       to crawlers, so the contact details must also live in the page itself. -->
  <section class="max-w-2xl mx-auto px-8 pb-12" aria-label="Contact information">
    <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 grid sm:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h2 class="font-semibold text-gray-900 mb-2">Battle Electric, LLC</h2>
        <p>13254 SW 263rd St<br />Homestead, FL 33032</p>
        <p class="mt-2 text-gray-500">{LICENSE_LABEL}</p>
      </div>
      <div class="space-y-2">
        <p>
          <a href="tel:+17864043885" class="font-semibold text-gray-900 hover:underline underline-offset-4">(786) 404-3885</a>
        </p>
        <p>
          <a href="mailto:battleelectric050@gmail.com" class="hover:underline underline-offset-4">battleelectric050@gmail.com</a>
        </p>
        <p>Mon–Sat 7:00 AM–7:00 PM<br />24/7 emergency service</p>
      </div>
    </div>
  </section>
  <Faq items={CONTACT_FAQS} />
</Layout>



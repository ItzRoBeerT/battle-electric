---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { BUSINESS_ID, LICENSE_LABEL } from '../data/business';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	robots?: string;
}

const {
	title = 'Licensed Electrician in Miami, FL | Battle Electric',
	description = 'Licensed & insured electricians serving Miami-Dade, Broward and Monroe. EV charger installation, panel upgrades, smart panels. Free estimates — (786) 404-3885.',
	canonical,
	robots,
} = Astro.props;

// Canonical: normalized pathname on the canonical host (www), overridable per page.
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonical ?? new URL(pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'Electrician',
	'@id': BUSINESS_ID,
	name: 'Battle Electric',
	legalName: 'Battle Electric, LLC',
	// Regular hours live in openingHoursSpecification; the 24/7 emergency
	// promise is stated here so the schema doesn't contradict the site copy.
	description:
		'Licensed and insured electrical contractor serving Miami-Dade, Broward and Monroe counties. Regular hours Mon–Sat 7:00 AM–7:00 PM, with 24/7 emergency service.',
	url: Astro.site?.href,
	telephone: '+17864043885',
	email: 'battleelectric050@gmail.com',
	image: ogImage,
	logo: new URL('/logo_final.png', Astro.site).href,
	address: {
		'@type': 'PostalAddress',
		streetAddress: '13254 SW 263rd St',
		addressLocality: 'Homestead',
		addressRegion: 'FL',
		postalCode: '33032',
		addressCountry: 'US',
	},
	areaServed: [
		{ '@type': 'AdministrativeArea', name: 'Miami-Dade County' },
		{ '@type': 'AdministrativeArea', name: 'Broward County' },
		{ '@type': 'AdministrativeArea', name: 'Monroe County' },
		{ '@type': 'AdministrativeArea', name: 'Lee County' },
		{ '@type': 'AdministrativeArea', name: 'Orange County' },
		{ '@type': 'AdministrativeArea', name: 'Seminole County' },
		{ '@type': 'City', name: 'Miami' },
		{ '@type': 'City', name: 'Homestead' },
		{ '@type': 'City', name: 'Coral Gables' },
		{ '@type': 'City', name: 'Miramar' },
		{ '@type': 'City', name: 'Fort Lauderdale' },
		{ '@type': 'City', name: 'Fort Myers' },
	],
	openingHoursSpecification: {
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
		opens: '07:00',
		closes: '19:00',
	},
	sameAs: [
		// Google Business Profile listing (canonical CID form).
		'https://www.google.com/maps?cid=5908478874112194907',
		'https://www.facebook.com/people/Battle-Electric-LLC/100076241703095/',
		'https://instagram.com/battleelectric',
		'https://www.bbb.org/us/fl/homestead/profile/electrical-contractors/battle-electric-llc-0633-90607188',
		'https://nextdoor.com/pages/battle-electric-llc-homestead-fl/',
		'https://www.buildzoom.com/contractor/battle-electric-llc',
		'https://www.angi.com/companylist/us/fl/homestead/battle-electric-reviews-1.htm',
		'https://www.homeadvisor.com/rated.Battle.126412546.html',
		'https://www.thumbtack.com/fl/homestead/electrical-repairs/battle-electric/service/446001654848380937',
	],
	hasCredential: {
		'@type': 'EducationalOccupationalCredential',
		credentialCategory: 'license',
		name: `Florida Certified Electrical Contractor — ${LICENSE_LABEL}`,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<Font cssVariable="--font-inter" preload />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta
			name="robots"
			content={robots ?? 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
		/>
		<!-- Social sharing -->
		<meta property="og:site_name" content="Battle Electric" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Battle Electric — licensed electricians in South Florida" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

		<ClientRouter />
		<!-- Google Tag Manager -->
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-MZ84NWK4');
		</script>
		<!-- End Google Tag Manager -->
		<!-- Meta Pixel Code -->
		<script is:inline>
			!function(f,b,e,v,n,t,s)
			{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
			n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
			n.queue=[];t=b.createElement(e);t.async=!0;
			t.src=v;s=b.getElementsByTagName(e)[0];
			s.parentNode.insertBefore(t,s)}(window, document,'script',
			'https://connect.facebook.net/en_US/fbevents.js');
			fbq('init', '1533980148158925');
			fbq('track', 'PageView');
		</script>
		<!-- End Meta Pixel Code -->
		<!-- SPA pageview bridge: ClientRouter navigations are client-side, so GTM and
		     the Meta Pixel only see the initial load. Push a virtual page_view per
		     navigation; skip the first astro:page-load (already counted above). -->
		<script is:inline>
			(function () {
				var first = true;
				document.addEventListener('astro:page-load', function () {
					if (first) { first = false; return; }
					window.dataLayer && window.dataLayer.push({
						event: 'page_view',
						page_location: location.href,
						page_title: document.title,
					});
					window.fbq && window.fbq('track', 'PageView');
				});
				// Conversion micro-events: delegated so it covers every current and
				// future tel:/mailto: link and survives ClientRouter navigations.
				document.addEventListener('click', function (e) {
					var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
					if (!a) return;
					var href = a.getAttribute('href');
					window.dataLayer && window.dataLayer.push({
						event: href.indexOf('tel:') === 0 ? 'phone_click' : 'email_click',
						link_url: href,
						page_location: location.href,
					});
				});
			})();
		</script>
		<!-- Start Ad360 Event Pixel Snippet -->
		<script is:inline>
			!function(e,t,n,i,p,s,a,c,o){e[p]||((a=e[p]=function(){a.process?a.process.apply(a,arguments):a.queue.push(arguments)}).queue=[],a.t=1*new Date,(c=t.createElement(n)).async=1,c.src="https://cdn.ad360.media/js/ad360pixelevent.min.js?t="+864e5*Math.ceil(new Date/864e5),(o=t.getElementsByTagName(n)[0]).parentNode.insertBefore(c,o))}(window,document,"script",0,"ad360"),
			ad360("init","396120d6-cc31-48e9-875f-a4d3296ecbc2"),ad360("event","af3ed189-6d20-4eaf-93bb-c54218d0fc4e");
		</script>
		<!-- End Ad360 Event Pixel Snippet -->
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MZ84NWK4"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<!-- Meta Pixel (noscript) -->
		<noscript><img height="1" width="1" style="display:none"
		src="https://www.facebook.com/tr?id=1533980148158925&ev=PageView&noscript=1"
		/></noscript>
		<!-- End Meta Pixel (noscript) -->
		<Analytics />
		<Header />
		<slot />
		<SpeedInsights />
		<Footer />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}

	body {
		background-color: #f3f3f3;
		margin: 0;
		width: 100%;
	}
</style>
